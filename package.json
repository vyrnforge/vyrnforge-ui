{
  "name": "vyrnforge",
  "version": "0.0.0-rebuild",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "npm@11.16.0",
  "engines": { "node": ">=24.18 <25", "npm": ">=11.16 <12" },
  "workspaces": ["packages/core", "packages/web", "packages/icons", "packages/react", "packages/angular", "packages/vue", "packages/elements"],
  "scripts": {
    "clean": "node tooling/clean.mjs",
    "generate:tokens": "node tooling/tokens/generate.mjs --write",
    "verify:tokens": "node tooling/tokens/generate.mjs --check",
    "build": "npm run build:core && npm run build:web && npm run build:icons && npm run build:react && npm run build:angular && npm run build:vue && npm run build:elements",
    "build:core": "npm run build --workspace @vyrnforge/core",
    "build:web": "npm run build --workspace @vyrnforge/web",
    "build:icons": "npm run build --workspace @vyrnforge/icons",
    "build:react": "npm run build --workspace @vyrnforge/react",
    "build:angular": "npm run build --workspace @vyrnforge/angular",
    "build:vue": "npm run build --workspace @vyrnforge/vue",
    "build:elements": "npm run build --workspace @vyrnforge/elements",
    "build:docs": "npm run build && npm run build:docs:site",
    "build:docs:site": "node tooling/docs/build.mjs",
    "check:full": "node tooling/impact/execute.mjs --mode full",
    "check:changed": "node tooling/impact/local.mjs",
    "check:changed:plan": "node tooling/impact/local.mjs --dry-run",
    "lint:tooling": "eslint tooling playwright.config.mjs eslint.config.mjs stylelint.config.mjs",
    "lint:docs": "eslint apps/docs && stylelint \"apps/docs/**/*.css\"",
    "lint:web-css": "stylelint \"packages/web/src/**/*.css\"",
    "lint:packages": "eslint \"packages/{core,web,icons,react,angular,vue,elements}/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:core": "eslint \"packages/core/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:web": "eslint \"packages/web/src/**/*.{ts,tsx,mts,cts}\" \"packages/web/build/**/*.mjs\"",
    "lint:icons": "eslint \"packages/icons/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:react": "eslint \"packages/react/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:angular": "eslint \"packages/angular/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:vue": "eslint \"packages/vue/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:elements": "eslint \"packages/elements/src/**/*.{ts,tsx,mts,cts}\"",
    "verify:structure": "node tooling/verify/workspace-structure.mjs",
    "verify:boundaries": "node tooling/verify/package-boundaries.mjs",
    "verify:architecture": "node tooling/verify/architecture-rules.mjs",
    "verify:packages": "node tooling/verify/package-contracts.mjs",
    "verify:compatibility": "node tooling/verify/compatibility.mjs",
    "verify:documentation": "node tooling/verify/documentation-structure.mjs",
    "verify:docs-site": "node tooling/verify/docs-site.mjs",
    "verify:testing-structure": "node tooling/verify/testing-structure.mjs",
    "verify:changes": "node tooling/verify/change-fragments.mjs",
    "changes:preview": "node tooling/release/render.mjs",
    "verify:consumer": "node tooling/verify/consumer-packages.mjs",
    "test:component:types": "node tooling/testing/check-component-types.mjs",
    "test:component:ssr": "node tooling/testing/run-component-ssr.mjs",
    "test:component:browser": "node tooling/testing/run-component-browser.mjs",
    "test:browser:docs": "node tooling/docs/run-browser.mjs chromium",
    "test:browser:docs:cross": "node tooling/docs/run-browser.mjs all",
    "test:visual:foundation": "node tooling/testing/visual/run-foundation.mjs",
    "test:impact": "node --test tooling/impact/plan.test.mjs tooling/impact/executor.test.mjs tooling/impact/browser-concurrency.test.mjs tooling/impact/tiers.test.mjs tooling/impact/local.test.mjs tooling/impact/modes.test.mjs tooling/testing/discovery.test.mjs",
    "test:testing-tooling": "node --test tooling/testing/component-browser-config.test.mjs",
    "test:accessibility-tooling": "node --test tooling/testing/accessibility/component-standards.test.mjs",
    "test:ci-tooling": "node --test tooling/ci/retention.test.mjs",
    "test:docs-tooling": "node --test tooling/docs/examples.test.mjs",
    "test:tooling": "npm run test:impact && npm run test:testing-tooling && npm run test:accessibility-tooling && npm run test:ci-tooling && npm run test:docs-tooling"
  },
  "devDependencies": {
    "@angular/common": "22.2.3", "@angular/compiler": "22.2.3", "@angular/compiler-cli": "22.2.3", "@angular/core": "22.2.3", "@angular/platform-browser": "22.2.3", "@angular/platform-server": "22.2.3",
    "@playwright/test": "1.64.1", "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "@vue/server-renderer": "3.5.44", "axe-core": "4.14.0", "esbuild": "0.28.2", "eslint": "10.13.0", "react": "19.3.0", "react-dom": "19.3.0", "rxjs": "7.8.2", "stylelint": "17.16.0", "typescript": "6.0.3", "typescript-eslint": "8.71.2", "vue": "3.5.44"
  }
}
