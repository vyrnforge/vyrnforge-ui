{
  "name": "vyrnforge",
  "version": "0.0.0-rebuild",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18 <25",
    "npm": ">=11.16 <12"
  },
  "workspaces": [
    "packages/core",
    "packages/web",
    "packages/react",
    "packages/angular",
    "packages/vue",
    "packages/elements"
  ],
  "scripts": {
    "clean": "node tooling/build/clean.mjs",
    "build": "npm run build:core && npm run build:web && npm run build:react && npm run build:angular && npm run build:vue && npm run build:elements",
    "build:core": "npm run build --workspace @vyrnforge/core",
    "build:web": "npm run build --workspace @vyrnforge/web",
    "build:react": "npm run build --workspace @vyrnforge/react",
    "build:angular": "npm run build --workspace @vyrnforge/angular",
    "build:vue": "npm run build --workspace @vyrnforge/vue",
    "build:elements": "npm run build --workspace @vyrnforge/elements",
    "build:docs": "node tooling/docs/build.mjs",
    "check": "node tooling/impact/execute.mjs --mode main",
    "verify:structure": "node tooling/verify/workspace-structure.mjs",
    "verify:boundaries": "node tooling/verify/package-boundaries.mjs",
    "verify:architecture": "node tooling/verify/architecture-rules.mjs",
    "verify:legacy": "node tooling/verify/legacy-isolation.mjs",
    "verify:packages": "node tooling/verify/package-contracts.mjs",
    "verify:compatibility": "node tooling/verify/compatibility.mjs",
    "verify:documentation": "node tooling/verify/documentation-structure.mjs",
    "verify:docs-site": "node tooling/verify/docs-site.mjs",
    "verify:package-smoke": "node tooling/verify/package-smoke.mjs",
    "verify:consumer": "node tooling/verify/consumer-packages.mjs",
    "test:impact": "node --test tooling/tests/impact-plan.test.mjs tooling/tests/impact-executor.test.mjs tooling/tests/impact-tiers.test.mjs",
    "ci:plan": "node tooling/impact/plan.mjs",
    "ci:pr": "node tooling/impact/execute.mjs --mode pr",
    "ci:main": "node tooling/impact/execute.mjs --mode main",
    "ci:scheduled": "node tooling/impact/execute.mjs --mode scheduled",
    "ci:release": "node tooling/impact/execute.mjs --mode release"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
