{
  "name": "vyrnforge",
  "version": "0.0.0-rebuild",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.16.1",
  "engines": {"node": ">=24.18 <25", "pnpm": ">=12.16 <13"},
  "scripts": {
    "clean": "node tooling/clean.mjs",
    "format": "prettier --write playwright.config.mjs vitest.config.mjs prettier.config.mjs tooling/testing/angular-vitest.setup.mjs",
    "format:check": "prettier --check playwright.config.mjs vitest.config.mjs prettier.config.mjs tooling/testing/angular-vitest.setup.mjs",
    "generate:tokens": "node tooling/tokens/generate.mjs",
    "verify:tokens": "node tooling/tokens/generate.mjs --check",
    "build": "nx run-many -t build",
    "build:docs": "nx run docs:build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:unit": "nx run-many -t test",
    "test:browser": "playwright test --project=chromium",
    "test:browser:cross": "playwright test",
    "check": "pnpm format:check && nx run-many -t lint,typecheck,test,build && pnpm verify:structure && pnpm verify:testing-structure && pnpm verify:boundaries && pnpm verify:architecture && pnpm verify:impact && pnpm verify:workflows",
    "check:full": "pnpm check",
    "check:changed": "node tooling/impact/plan.mjs --mode local && nx affected -t lint,typecheck,test,build",
    "verify:structure": "node tooling/verify/workspace-structure.mjs",
    "verify:testing-structure": "node tooling/verify/testing-structure.mjs",
    "verify:boundaries": "node tooling/verify/package-boundaries.mjs",
    "verify:architecture": "node tooling/verify/architecture-rules.mjs",
    "verify:impact": "vitest run tooling/impact/plan.test.mjs",
    "verify:package-contracts": "node tooling/verify/package-contracts.mjs",
    "verify:compatibility": "node tooling/verify/compatibility.mjs",
    "verify:workflows": "node tooling/verify/workflows.mjs",
    "verify:api": "node tooling/verify/api-reports.mjs",
    "verify:api:update": "node tooling/verify/api-reports.mjs --local",
    "verify:packages": "node tooling/verify/package-artifacts.mjs",
    "verify:release": "vitest run tooling/release/changesets.test.mjs && node tooling/release/verify-status.mjs",
    "impact:plan": "node tooling/impact/plan.mjs --mode local",
    "changeset": "changeset",
    "changeset:status": "node tooling/release/verify-status.mjs",
    "release:version": "changeset version",
    "release": "pnpm verify:release && pnpm verify:packages && changeset publish"
  },
  "devDependencies": {
    "@angular/common":"22.2.3","@angular/compiler":"22.2.3","@angular/compiler-cli":"22.2.3","@angular/core":"22.2.3","@angular/platform-browser":"22.2.3","@angular/platform-server":"22.2.3","@playwright/test":"1.64.1","@types/react":"19.3.0","@types/react-dom":"19.3.0","@vue/server-renderer":"3.5.44","axe-core":"4.14.0","esbuild":"0.28.2","eslint":"10.13.0","react":"19.3.0","react-dom":"19.3.0","rxjs":"7.8.2","stylelint":"17.16.0","typescript":"6.0.3","typescript-eslint":"8.71.2","vue":"3.5.44","@arethetypeswrong/cli":"0.18.5","@axe-core/playwright":"4.14.0","@changesets/cli":"3.0.3","@microsoft/api-extractor":"7.59.4","cross-env":"10.1.0","ng-packagr":"22.2.5","nx":"24.0.2","prettier":"3.9.0","publint":"0.3.25","vitest":"5.0.5","@vyrnforge/core":"workspace:*","@vyrnforge/web":"workspace:*","@vyrnforge/icons":"workspace:*","@vyrnforge/react":"workspace:*","@vyrnforge/angular":"workspace:*","@vyrnforge/vue":"workspace:*","@vyrnforge/elements":"workspace:*"
  }
}
