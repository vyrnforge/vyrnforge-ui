{
  "name": "vyrnforge",
  "version": "0.0.0-rebuild",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18 <25",
    "npm": ">=11.16 <12"
  },
  "workspaces": [
    "packages/core",
    "packages/web",
    "packages/react",
    "packages/angular",
    "packages/vue",
    "packages/elements"
  ],
  "scripts": {
    "clean": "node tooling/build/clean.mjs",
    "build": "npm run build:core && npm run build:web && npm run build:react && npm run build:angular && npm run build:vue && npm run build:elements",
    "build:core": "npm run build --workspace @vyrnforge/core",
    "build:web": "npm run build --workspace @vyrnforge/web",
    "build:react": "npm run build --workspace @vyrnforge/react",
    "build:angular": "npm run build --workspace @vyrnforge/angular",
    "build:vue": "npm run build --workspace @vyrnforge/vue",
    "build:elements": "npm run build --workspace @vyrnforge/elements",
    "build:docs": "node tooling/docs/build.mjs",
    "check": "node tooling/impact/execute.mjs --mode main",
    "lint:tooling": "eslint tooling playwright.config.mjs eslint.config.mjs stylelint.config.mjs",
    "lint:docs": "eslint apps/docs && stylelint \"apps/docs/**/*.css\"",
    "lint:web-css": "stylelint \"packages/web/src/**/*.css\"",
    "lint:packages": "eslint \"packages/{core,web,react,angular,vue,elements}/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:core": "eslint \"packages/core/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:web": "eslint \"packages/web/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:react": "eslint \"packages/react/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:angular": "eslint \"packages/angular/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:vue": "eslint \"packages/vue/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:elements": "eslint \"packages/elements/src/**/*.{ts,tsx,mts,cts}\"",
    "verify:structure": "node tooling/verify/workspace-structure.mjs",
    "verify:boundaries": "node tooling/verify/package-boundaries.mjs",
    "verify:architecture": "node tooling/verify/architecture-rules.mjs",
    "verify:legacy": "node tooling/verify/legacy-isolation.mjs",
    "verify:packages": "node tooling/verify/package-contracts.mjs",
    "verify:compatibility": "node tooling/verify/compatibility.mjs",
    "verify:foundation-readiness": "node tooling/verify/foundation-readiness.mjs",
    "verify:documentation": "node tooling/verify/documentation-structure.mjs",
    "verify:docs-site": "node tooling/verify/docs-site.mjs",
    "verify:testing-structure": "node tooling/verify/testing-structure.mjs",
    "verify:package-smoke": "node tooling/verify/package-smoke.mjs",
    "verify:consumer": "node tooling/verify/consumer-packages.mjs",
    "test:browser:docs": "node tooling/browser/run.mjs chromium",
    "test:browser:docs:cross": "node tooling/browser/run.mjs all",
    "test:impact": "node --test tooling/tests/impact-plan.test.mjs tooling/tests/impact-executor.test.mjs tooling/tests/impact-tiers.test.mjs tooling/tests/actions-retention.test.mjs",
    "test:actions-retention": "node --test tooling/tests/actions-retention.test.mjs",
    "ci:plan": "node tooling/impact/plan.mjs",
    "ci:pr": "node tooling/impact/execute.mjs --mode pr",
    "ci:main": "node tooling/impact/execute.mjs --mode main",
    "ci:scheduled": "node tooling/impact/execute.mjs --mode scheduled",
    "ci:release": "node tooling/impact/execute.mjs --mode release"
  },
  "devDependencies": {
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vue": "3.5.44"
  }
}
