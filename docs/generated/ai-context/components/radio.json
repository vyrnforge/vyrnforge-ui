      "checkValidity",
      "reportValidity",
      "setCustomValidity"
    ],
    "accessibility": [
      "native radio semantics",
      "accessible label",
      "checked/disabled/required states",
      "ElementInternals form participation"
    ],
    "formAssociation": "none"
  },
  "source": {
