{
  "schemaVersion": 1,
  "id": "transfer-list",
  "name": "TransferList",
  "package": "@vyrnforge/ui-components",
  "category": "data-display",
  "maturity": "experimental",
  "availability": "available",
  "purpose": "Dual-list assignment component for moving a moderate known collection between available and assigned states.",
  "guidance": {
    "useWhen": "Use for bounded known collections where users need to see available and assigned items simultaneously and move items reversibly.",
    "avoidWhen": "Avoid for thousands of items, server pagination, complex IAM permission inheritance, hierarchical resources, approval/audit workflows, or data-grid use cases.",
    "aiUsageNotes": "Use only for bounded local assignment. Apps own backend fetching, server search, pagination, approvals, and persistence. Do not use as a UniversalDataGrid replacement, IAM permission catalog, tree transfer, drag-and-drop transfer, or virtualized selector.",
    "relatedComponents": [
      "Checkbox",
      "MultiSelect",
      "Autocomplete",
      "Select",
      "UniversalDataGrid"
    ]
  },
  "accessibility": [
    "Uses labelled groups, native checkboxes, and native buttons. Option descriptions are associated with checkboxes. It intentionally avoids incorrect listbox semantics for checkbox-based multi-selection.",
    "labeled source and target groups",
    "keyboard-accessible move actions",
    "selection state",
    "ElementInternals form participation"
  ],
  "knownLimitations": [
    "Avoid for thousands of items, server pagination, complex IAM permission inheritance, hierarchical resources, approval/audit workflows, or data-grid use cases."
  ],
  "styling": {
    "classes": [
      "vf-transfer-list",
      "vf-transfer-list__panel",
      "vf-transfer-list__options",
      "vf-transfer-list__option",
      "vf-transfer-list__actions"
    ],
    "variables": []
  },
  "frameworks": {
    "react": {
      "status": "current",
      "package": "@vyrnforge/ui-components",
      "setup": "import { TransferList } from '@vyrnforge/ui-components';",
      "example": "<TransferList options={[{ value: 'iam', label: 'Identity and Access Management' }]} defaultValue={['iam']} />"
    },
    "native-html": {
      "status": "current",
      "package": "@vyrnforge/ui-elements",
      "setup": "import \"@vyrnforge/ui-elements/register\";",
      "example": "<vf-transfer-list></vf-transfer-list>"
    },
    "angular": {
      "status": "verified-consumer",
      "package": "@vyrnforge/ui-elements",
      "setup": "schemas: [CUSTOM_ELEMENTS_SCHEMA]\n// import \"@vyrnforge/ui-elements/register\" from application bootstrap",
      "example": "<vf-transfer-list></vf-transfer-list>"
    },
    "vue": {
      "status": "verified-consumer",
      "package": "@vyrnforge/ui-elements",
      "setup": "compilerOptions: { isCustomElement: (tag) => tag.startsWith('vf-') }",
      "example": "<vf-transfer-list></vf-transfer-list>"
    }
  },
