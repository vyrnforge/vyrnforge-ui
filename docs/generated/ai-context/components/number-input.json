{
  "schemaVersion": 1,
  "id": "number-input",
  "name": "NumberInput",
  "package": "@vyrnforge/ui-components",
  "category": "form-control",
  "maturity": "experimental",
  "availability": "available",
  "purpose": "Native input type='number' control aligned with VyrnForge input styling, with integer and decimal typing modes.",
  "guidance": {
    "useWhen": "Use for numeric settings, quantities, limits, and scores.",
    "avoidWhen": "Avoid for formatted currency or masked values.",
    "aiUsageNotes": "Use mode='integer' for whole numbers and mode='decimal' with step for decimal values; do not build custom spinner UI.",
    "relatedComponents": [
      "TextInput",
      "Field"
    ]
  },
  "accessibility": [
    "Numeric constraints need clear labels and validation.",
    "native number-input semantics",
    "accessible label",
    "numeric validity",
    "ElementInternals form participation"
  ],
  "knownLimitations": [
    "Avoid for formatted currency or masked values."
  ],
  "styling": {
    "classes": [
      "vf-number-input",
      "vf-input"
    ],
    "variables": []
  },
  "frameworks": {
    "react": {
      "status": "current",
      "package": "@vyrnforge/ui-components",
      "setup": "import { NumberInput } from '@vyrnforge/ui-components';",
      "example": "<NumberInput mode='integer' min={0} max={100} defaultValue={50} />"
    },
    "native-html": {
      "status": "current",
      "package": "@vyrnforge/ui-elements",
      "setup": "import \"@vyrnforge/ui-elements/register\";",
      "example": "<vf-number-input></vf-number-input>"
    },
    "angular": {
      "status": "verified-consumer",
      "package": "@vyrnforge/ui-elements",
      "setup": "schemas: [CUSTOM_ELEMENTS_SCHEMA]\n// import \"@vyrnforge/ui-elements/register\" from application bootstrap",
      "example": "<vf-number-input></vf-number-input>"
    },
    "vue": {
      "status": "verified-consumer",
      "package": "@vyrnforge/ui-elements",
      "setup": "compilerOptions: { isCustomElement: (tag) => tag.startsWith('vf-') }",
      "example": "<vf-number-input></vf-number-input>"
    }
  },
