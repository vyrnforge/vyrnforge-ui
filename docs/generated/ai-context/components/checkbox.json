{
  "schemaVersion": 1,
  "id": "checkbox",
  "name": "Checkbox",
  "package": "@vyrnforge/ui-components",
  "category": "form-control",
  "maturity": "experimental",
  "availability": "available",
  "purpose": "Native checkbox control.",
  "guidance": {
    "useWhen": "Use for independent binary choices.",
    "avoidWhen": "Avoid for mutually exclusive sets; use Radio when available.",
    "aiUsageNotes": "Use for true/false preferences and row selection.",
    "relatedComponents": [
      "Field",
      "UniversalDataGrid"
    ]
  },
  "accessibility": [
    "Ensure label text describes the checked state.",
    "native checkbox semantics",
    "accessible label",
    "checked/disabled/required states",
    "ElementInternals form participation"
  ],
  "knownLimitations": [
    "Avoid for mutually exclusive sets; use Radio when available."
  ],
  "styling": {
    "classes": [
      "vf-checkbox"
    ],
    "variables": []
  },
  "frameworks": {
    "react": {
      "status": "current",
      "package": "@vyrnforge/ui-components",
      "setup": "import { Checkbox } from '@vyrnforge/ui-components';",
      "example": "<Checkbox checked={enabled} onChange={(event) => setEnabled(event.currentTarget.checked)} label='Enabled' />"
    },
    "native-html": {
      "status": "current",
      "package": "@vyrnforge/ui-elements",
      "setup": "import \"@vyrnforge/ui-elements/register\";",
      "example": "<vf-checkbox></vf-checkbox>"
    },
    "angular": {
      "status": "verified-consumer",
      "package": "@vyrnforge/ui-elements",
      "setup": "schemas: [CUSTOM_ELEMENTS_SCHEMA]\n// import \"@vyrnforge/ui-elements/register\" from application bootstrap",
      "example": "<vf-checkbox></vf-checkbox>"
    },
    "vue": {
      "status": "verified-consumer",
      "package": "@vyrnforge/ui-elements",
      "setup": "compilerOptions: { isCustomElement: (tag) => tag.startsWith('vf-') }",
      "example": "<vf-checkbox></vf-checkbox>"
    }
  },
