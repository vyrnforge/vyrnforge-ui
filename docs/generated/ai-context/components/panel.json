    "react": {
      "status": "current",
      "package": "@vyrnforge/ui-components",
      "setup": "import { Panel } from '@vyrnforge/ui-components';",
      "example": "<Panel title='Settings'>Content</Panel>"
    },
    "native-html": {
      "status": "current",
      "package": "@vyrnforge/ui-elements",
      "setup": "import \"@vyrnforge/ui-elements/register\";",
      "example": "<vf-panel></vf-panel>"
