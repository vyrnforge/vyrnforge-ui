{
  "schemaVersion": 1,
  "id": "badge",
  "name": "Badge",
  "package": "@vyrnforge/ui-components",
  "category": "feedback",
  "maturity": "experimental",
  "availability": "available",
  "purpose": "Compact status or metadata label.",
  "guidance": {
    "useWhen": "Use for short neutral, info, success, warning, or danger labels.",
    "avoidWhen": "Avoid for long messages; use InlineMessage or Alert.",
