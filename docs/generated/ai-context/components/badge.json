    "relatedComponents": [
      "StatusBadge",
      "InlineMessage"
    ]
  },
  "accessibility": [
    "Do not rely on color alone for meaning.",
    "text remains available to assistive technology"
  ],
  "knownLimitations": [
    "Avoid for long messages; use InlineMessage or Alert."
  ],
  "styling": {
    "classes": [
      "vf-badge"
    ],
    "variables": []
  },
  "frameworks": {
    "react": {
      "status": "current",
      "package": "@vyrnforge/ui-components",
      "setup": "import { Badge } from '@vyrnforge/ui-components';",
      "example": "<Badge variant='success'>Active</Badge>"
    },
    "native-html": {
      "status": "current",
      "package": "@vyrnforge/ui-elements",
      "setup": "import \"@vyrnforge/ui-elements/register\";",
      "example": "<vf-badge></vf-badge>"
    },
    "angular": {
      "status": "verified-consumer",
      "package": "@vyrnforge/ui-angular",
      "setup": "import { provideVyrnForge } from \"@vyrnforge/ui-angular\";\n// add provideVyrnForge() to bootstrapApplication providers",
      "example": "<vf-badge></vf-badge>"
    },
    "vue": {
      "status": "verified-consumer",
      "package": "@vyrnforge/ui-vue",
      "setup": "import { VyrnForgeVue } from \"@vyrnforge/ui-vue\";\napp.use(VyrnForgeVue);",
      "example": "<VfBadge></VfBadge>"
    }
  },
  "contract": {
