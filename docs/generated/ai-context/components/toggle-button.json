{
  "schemaVersion": 1,
  "id": "toggle-button",
  "name": "ToggleButton",
  "package": "@vyrnforge/ui-components",
  "category": "primitive",
  "maturity": "experimental",
  "availability": "available",
  "purpose": "Native pressable tool, formatting, or view action with controlled or uncontrolled pressed state.",
  "guidance": {
    "useWhen": "Use for an active tool, formatting option, or current-surface view action.",
    "avoidWhen": "Avoid for persistent settings; use Switch. Avoid navigation links.",
    "aiUsageNotes": "Do not substitute ToggleButton for a persistent Switch setting or navigation link.",
    "relatedComponents": [
      "Switch",
      "Button",
      "IconButton",
      "SegmentedControl",
      "ToggleButtonGroup"
    ]
  },
  "accessibility": [
    "Renders a native button with aria-pressed. Icon-only usage requires aria-label.",
    "native button semantics",
    "aria-pressed state",
    "accessible name"
  ],
  "knownLimitations": [
    "Avoid for persistent settings; use Switch. Avoid navigation links."
  ],
  "styling": {
    "classes": [
      "vf-toggle-button",
      "vf-toggle-button--pressed"
    ],
    "variables": []
  },
  "frameworks": {
    "react": {
      "status": "current",
      "package": "@vyrnforge/ui-components",
      "setup": "import { ToggleButton } from '@vyrnforge/ui-components';",
      "example": "<ToggleButton defaultPressed>Pin column</ToggleButton>"
    },
    "native-html": {
      "status": "current",
      "package": "@vyrnforge/ui-elements",
      "setup": "import \"@vyrnforge/ui-elements/register\";",
      "example": "<vf-toggle-button></vf-toggle-button>"
    },
    "angular": {
      "status": "verified-consumer",
