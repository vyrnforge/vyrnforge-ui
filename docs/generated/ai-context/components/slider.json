        "type": "boolean",
        "required": false,
        "default": false
      },
      {
        "name": "required",
        "type": "boolean",
        "required": false,
        "default": false
      },
      {
        "name": "label",
        "type": "string",
        "required": false,
        "default": ""
      },
      {
        "name": "max",
        "type": "number",
        "required": false,
        "default": 100
      },
      {
        "name": "min",
        "type": "number",
        "required": false,
        "default": 0
