{
  "schemaVersion": 1,
  "id": "slider",
  "name": "Slider",
  "package": "@vyrnforge/ui-components",
  "category": "form-control",
  "maturity": "experimental",
  "availability": "available",
  "purpose": "Native bounded numeric range input with optional displayed value.",
  "guidance": {
    "useWhen": "Use for a bounded numeric setting where range interaction is useful.",
    "avoidWhen": "Avoid for formatted or direct numeric entry; use NumberInput.",
    "aiUsageNotes": "Do not add dual-thumb ranges, tooltip positioning, or custom drag mathematics.",
    "relatedComponents": [
      "NumberInput",
      "Rating"
    ]
  },
  "accessibility": [
    "Uses native input type='range'; provide Field label or ariaLabel.",
    "native range semantics",
    "accessible label",
    "keyboard adjustment",
    "ElementInternals form participation"
  ],
  "knownLimitations": [
    "Avoid for formatted or direct numeric entry; use NumberInput."
  ],
  "styling": {
    "classes": [
      "vf-slider",
      "vf-slider__control",
      "vf-slider__value"
    ],
    "variables": []
  },
  "frameworks": {
    "react": {
      "status": "current",
      "package": "@vyrnforge/ui-components",
      "setup": "import { Slider } from '@vyrnforge/ui-components';",
      "example": "<Slider ariaLabel='Approval threshold' defaultValue={65} showValue />"
    },
    "native-html": {
      "status": "current",
      "package": "@vyrnforge/ui-elements",
      "setup": "import \"@vyrnforge/ui-elements/register\";",
      "example": "<vf-slider></vf-slider>"
    },
    "angular": {
      "status": "verified-consumer",
      "package": "@vyrnforge/ui-elements",
      "setup": "schemas: [CUSTOM_ELEMENTS_SCHEMA]\n// import \"@vyrnforge/ui-elements/register\" from application bootstrap",
      "example": "<vf-slider></vf-slider>"
    },
    "vue": {
      "status": "verified-consumer",
      "package": "@vyrnforge/ui-elements",
      "setup": "compilerOptions: { isCustomElement: (tag) => tag.startsWith('vf-') }",
      "example": "<vf-slider></vf-slider>"
    }
  },
  "contract": {
