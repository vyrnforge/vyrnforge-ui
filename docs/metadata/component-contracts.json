    {"name":"default","purpose":"Primary content or label."},{"name":"label","purpose":"Visible control or region label."},{"name":"description","purpose":"Supporting description or help text."},{"name":"prefix","purpose":"Leading decorative or actionable content."},{"name":"suffix","purpose":"Trailing decorative or actionable content."},{"name":"trigger","purpose":"Element that controls a composite or overlay."},{"name":"content","purpose":"Primary composite or overlay content."},{"name":"header","purpose":"Header region."},{"name":"footer","purpose":"Footer region."},{"name":"actions","purpose":"Action region."},{"name":"item","purpose":"Collection item template or projected item."},{"name":"empty","purpose":"Empty-state content."},{"name":"loading","purpose":"Loading-state content."}
