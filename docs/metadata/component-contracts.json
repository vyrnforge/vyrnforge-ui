  "eventVocabulary": [
    {"name":"vf-value-change","purpose":"A component value changed after a user or programmatic controller transition.","bubbles":true,"composed":true,"cancelable":false,"detail":[{"name":"value","type":{"kind":"unknown"},"required":true},{"name":"previousValue","type":{"kind":"unknown"},"required":false},{"name":"reason","type":{"kind":"string"},"required":true}]},
