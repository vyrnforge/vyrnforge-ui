    {"name":"vf-selection-change","purpose":"A single or multiple selection model changed.","bubbles":true,"composed":true,"cancelable":false,"detail":[{"name":"selection","type":{"kind":"unknown"},"required":true},{"name":"previousSelection","type":{"kind":"unknown"},"required":false},{"name":"reason","type":{"kind":"string"},"required":true}]},
    {"name":"vf-checked-change","purpose":"A checked or mixed state changed.","bubbles":true,"composed":true,"cancelable":false,"detail":[{"name":"checked","type":{"kind":"unknown"},"required":true},{"name":"previousChecked","type":{"kind":"unknown"},"required":false},{"name":"reason","type":{"kind":"string"},"required":true}]},
    {"name":"vf-pressed-change","purpose":"A pressed or selected tool state changed.","bubbles":true,"composed":true,"cancelable":false,"detail":[{"name":"pressed","type":{"kind":"boolean"},"required":true},{"name":"previousPressed","type":{"kind":"boolean"},"required":true},{"name":"reason","type":{"kind":"string"},"required":true}]},
    {"name":"vf-action","purpose":"A primary component action was invoked.","bubbles":true,"composed":true,"cancelable":true,"detail":[{"name":"action","type":{"kind":"string"},"required":false},{"name":"value","type":{"kind":"unknown"},"required":false},{"name":"reason","type":{"kind":"string"},"required":true}]},
    {"name":"vf-dismiss","purpose":"A dismissible surface requested closure.","bubbles":true,"composed":true,"cancelable":true,"detail":[{"name":"reason","type":{"kind":"string"},"required":true}]},
    {"name":"vf-invalid","purpose":"A form-associated component reported invalid state.","bubbles":true,"composed":true,"cancelable":true,"detail":[{"name":"validity","type":{"kind":"object","typeName":"ValidityState"},"required":true},{"name":"validationMessage","type":{"kind":"string"},"required":true}]},
    {"name":"vf-reset","purpose":"A component restored its initial form or controller state.","bubbles":true,"composed":true,"cancelable":false,"detail":[{"name":"value","type":{"kind":"unknown"},"required":false},{"name":"reason","type":{"kind":"string"},"required":true}]}
  ],
