{
  "schemaVersion": 2,
  "sourceOfTruth": {
    "canonical": true,
    "task": "BT-8006",
    "documentation": "docs/release/security-workflow-hardening.md"
  },
  "task": {
    "id": "BT-8006",
    "title": "Complete security and workflow hardening",
    "status": "done",
    "dependsOn": ["BT-8003"],
    "unlocksAfterMerge": ["BT-8007", "BT-8008"]
  },
  "controls": {
    "dependencyReview": {
      "workflow": ".github/workflows/ci.yml",
      "event": "pull_request",
      "failOnSeverity": "high"
    },
    "dependencyAudit": {
      "workflow": ".github/workflows/assurance.yml",
      "command": "npm audit --omit=dev --audit-level=high",
      "events": ["schedule", "workflow_dispatch"]
    },
    "codeql": {
      "workflow": ".github/workflows/assurance.yml",
      "language": "javascript-typescript",
      "buildMode": "none",
      "events": ["schedule", "workflow_dispatch"]
    },
    "workflowLint": {
      "workflows": [
        ".github/workflows/ci.yml",
        ".github/workflows/assurance.yml"
      ],
      "actionlintVersion": "1.7.12",
      "actionlintSha256": "8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8",
      "shellcheckRequired": true
    },
    "immutableActions": true,
    "longLivedTokensForbidden": true,
    "mandatoryAggregates": ["ci-gate", "assurance-gate"]
  },
  "protectedGate": {
    "workflow": ".github/workflows/ci.yml",
    "requiredCheck": "ci-gate",
    "requiredJobs": [
      "quality-checks",
      "integration-checks",
      "security-checks"
    ],
    "continueOnErrorForbidden": true,
    "unexpectedSkipsFail": true
  },
  "releasePreflight": {
    "workflow": ".github/workflows/release.yml",
    "requiredJobs": ["verify-release"],
    "releaseLineSizeBudgetVerificationRequired": true,
    "successfulCurrentMainCiRequired": true,
    "releaseArtifactVerificationRequired": true
  },
  "verification": {
    "command": "npm run verify:security-workflow-hardening",
    "testCommand": "npm run test:security-workflow-hardening",
    "workflows": [
      ".github/workflows/ci.yml",
      ".github/workflows/assurance.yml"
    ]
  },
  "releaseReadiness": "not-ready"
}
