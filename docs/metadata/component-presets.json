      },
      "surfaceBindings": {
        "native": { "package": "@vyrnforge/ui-elements", "supportLevel": "first-class", "mode": "composition-helper", "target": "button", "publicName": null },
        "react": { "package": "@vyrnforge/ui-components", "supportLevel": "first-class", "mode": "named-export", "target": "button", "publicName": "ToastAction" },
        "angular": { "package": "@vyrnforge/ui-angular", "supportLevel": "first-class", "mode": "composition-helper", "target": "button", "publicName": null },
        "vue": { "package": "@vyrnforge/ui-vue", "supportLevel": "first-class", "mode": "composition-helper", "target": "button", "publicName": null }
      }
