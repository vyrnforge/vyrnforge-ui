{
  "$schema": "./component-presets.schema.json",
  "schemaVersion": 1,
  "sourceOfTruth": {
    "canonical": true,
    "scope": "framework-neutral named presets, transform aliases, and composition helpers over canonical VyrnForge components",
    "documentation": "docs/architecture/15-component-presets-and-aliases.md"
  },
  "presets": [
    {
      "id": "status-badge",
      "baseComponent": "badge",
      "kind": "transform",
      "description": "Status-oriented Badge preset with framework-neutral status-to-variant normalization.",
      "publicInputs": [
        { "name": "status", "type": "string", "required": true },
        { "name": "label", "type": "string", "required": false },
        { "name": "variantMap", "type": "record", "required": false }
      ],
      "baseDefaults": {},
      "semanticDefaults": {},
      "transforms": [
        {
          "input": "status",
          "overrideInput": "variantMap",
          "outputProperty": "variant",
          "map": {
            "active": "success",
            "success": "success",
            "inactive": "neutral",
            "neutral": "neutral",
            "pending": "warning",
            "warning": "warning",
            "danger": "danger",
            "error": "danger",
            "info": "info"
          },
          "fallback": "neutral"
        }
      ],
      "content": {
        "mode": "default-region",
        "sourceOrder": ["default", "label", "status"]
      },
      "surfaceBindings": {
        "native": {
          "package": "@vyrnforge/ui-elements",
          "supportLevel": "first-class",
          "mode": "base-component",
          "target": "badge",
          "publicName": null
        },
        "react": {
          "package": "@vyrnforge/ui-components",
          "supportLevel": "first-class",
          "mode": "named-export",
          "target": "badge",
          "publicName": "StatusBadge"
        },
        "angular": {
          "package": "@vyrnforge/ui-angular",
          "supportLevel": "first-class",
          "mode": "base-component",
          "target": "badge",
          "publicName": null
        },
        "vue": {
          "package": "@vyrnforge/ui-vue",
          "supportLevel": "first-class",
          "mode": "base-component",
          "target": "badge",
          "publicName": null
        }
      }
    },
    {
