{
  "schemaVersion": 1,
  "sourceOfTruth": "docs/README.md",
  "packages": [
    {
      "name": "@vyrnforge/ui-core",
      "purpose": "Shared VyrnForge design foundation for semantic tokens, themes, density, typography, motion, layers, utilities, and theme helpers.",
      "owns": [
        "primitive tokens",
        "semantic tokens",
        "themes",
        "density",
        "typography roles",
        "motion and reduced-motion contract",
        "layering model",
        "utility classes",
        "theme helper contracts"
      ],
      "doesNotOwn": [
        "React components",
        "Custom Element renderers",
        "component behavior controllers",
        "data grid behavior",
        "app state",
        "backend fetching",
        "business workflows"
      ],
      "cssImport": "@vyrnforge/ui-core/styles/index.css",
      "apiDoc": "docs/api/ui-core-api.md",
      "dependsOn": [],
      "mustNotDependOn": [
        "@vyrnforge/ui-behaviors",
        "@vyrnforge/ui-components",
        "@vyrnforge/ui-elements",
        "@vyrnforge/ui-angular",
        "@vyrnforge/ui-vue",
        "@vyrnforge/ui-data-grid",
        "React",
        "Vue",
        "Angular",
        "Redux",
        "TanStack",
        "MUI",
        "Radix",
        "Tailwind"
      ],
      "status": "current",
      "publicEntryPoints": [
        "@vyrnforge/ui-core",
        "@vyrnforge/ui-core/styles/index.css",
        "@vyrnforge/ui-core/style.css",
        "@vyrnforge/ui-core/index.css"
      ],
      "notes": "Lowest-level dependency-free runtime package. Canonical semantic token metadata lives in docs/metadata/design-tokens.json.",
      "releaseTrack": "non-grid-beta"
    },
    {
      "name": "@vyrnforge/ui-behaviors",
      "purpose": "Framework-neutral state, collection, selection, action, toggle, choice, numeric, Tabs, subscription, and reasoned event contracts for public non-grid components.",
      "owns": [
        "controlled and uncontrolled state transitions",
        "collection registration and ordering",
        "selection models",
        "action, toggle, choice, numeric, and Tabs decision models",
        "keyboard decision models",
        "validation state",
        "canonical controller events"
      ],
      "doesNotOwn": [
        "React rendering",
        "Custom Element rendering",
        "DOM focus execution",
        "DOM positioning",
        "application state",
        "backend workflows"
      ],
      "cssImport": "not-applicable",
      "apiDoc": "docs/api/ui-behaviors-api.md",
      "dependsOn": ["@vyrnforge/ui-core"],
      "mustNotDependOn": [
        "@vyrnforge/ui-components",
        "@vyrnforge/ui-elements",
        "@vyrnforge/ui-angular",
        "@vyrnforge/ui-vue",
        "@vyrnforge/ui-data-grid",
        "React",
        "React DOM",
        "Vue",
        "Angular",
        "Redux",
        "TanStack",
        "MUI",
        "Radix",
        "Tailwind"
      ],
      "status": "current",
      "releaseTrack": "non-grid-beta",
      "publicEntryPoints": ["@vyrnforge/ui-behaviors"],
      "notes": "Framework-neutral behavior foundations are current and remain renderer-independent."
    },
    {
      "name": "@vyrnforge/ui-components",
      "purpose": "First-class React surface for reusable VyrnForge primitives and application components, converging on the canonical native implementation where compatible.",
      "owns": [
        "React props and callbacks",
        "React refs and composition",
        "React lifecycle integration",
        "React compatibility behavior",
        "React surface styling"
      ],
      "doesNotOwn": [
        "canonical component semantics",
        "Angular or Vue integration",
        "data grid algorithms",
        "backend data",
        "global store",
        "tenant/auth/permissions"
      ],
      "cssImport": "@vyrnforge/ui-components/styles/index.css",
      "apiDoc": "docs/api/ui-components-api.md",
      "dependsOn": [
        "@vyrnforge/ui-core",
        "@vyrnforge/ui-behaviors",
        "@vyrnforge/ui-elements"
      ],
      "mustNotDependOn": [
        "@vyrnforge/ui-angular",
        "@vyrnforge/ui-vue",
        "@vyrnforge/ui-data-grid",
        "Redux",
        "TanStack",
        "MUI",
        "Radix",
        "Tailwind"
      ],
      "status": "current",
      "publicEntryPoints": [
        "@vyrnforge/ui-components",
        "@vyrnforge/ui-components/styles/index.css",
        "@vyrnforge/ui-components/style.css",
        "@vyrnforge/ui-components/index.css"
      ],
      "notes": "First-class React surface over shared VyrnForge foundations. The ui-elements dependency is the implemented canonical-backed convergence path; React-specific exceptions remain governed separately.",
      "releaseTrack": "non-grid-beta"
    },
    {
      "name": "@vyrnforge/ui-elements",
      "purpose": "Canonical browser-native Custom Element implementation and first-class Native HTML surface.",
      "owns": [
        "vf-* Custom Elements",
        "property and attribute reflection",
        "typed vf-* DOM events",
        "Light DOM rendering",
        "form-associated element integration",
        "explicit registration entry points"
      ],
      "doesNotOwn": [
        "React framework API",
        "Angular framework API",
        "Vue framework API",
        "application state",
        "backend workflows",
        "data grid rendering"
      ],
      "cssImport": "@vyrnforge/ui-elements/styles/index.css",
      "apiDoc": "docs/api/ui-elements-api.md",
      "dependsOn": ["@vyrnforge/ui-core", "@vyrnforge/ui-behaviors"],
      "mustNotDependOn": [
        "@vyrnforge/ui-components",
        "@vyrnforge/ui-angular",
        "@vyrnforge/ui-vue",
        "@vyrnforge/ui-data-grid",
        "React",
        "React DOM",
        "Vue",
        "Angular",
        "Redux",
        "TanStack",
        "MUI",
        "Radix",
        "Tailwind"
      ],
      "status": "current",
      "releaseTrack": "non-grid-beta",
      "publicEntryPoints": [
        "@vyrnforge/ui-elements",
        "@vyrnforge/ui-elements/register",
        "@vyrnforge/ui-elements/styles/index.css",
        "@vyrnforge/ui-elements/style.css",
        "@vyrnforge/ui-elements/index.css",
        "@vyrnforge/ui-elements/custom-elements.json"
      ],
      "notes": "First-class Native HTML / Custom Elements surface and default canonical browser implementation shared by framework facades."
    },
    {
      "name": "@vyrnforge/ui-angular",
      "purpose": "First-class Angular facade over VyrnForge canonical Custom Elements with generated typed bindings, package-owned setup, Forms integration, composition, and imperative references.",
      "owns": [
        "Angular generated facade directives and components",
        "Angular setup and registration integration",
        "Angular Forms ControlValueAccessor and Validator integration",
        "Angular-specific template, projection, and reference ergonomics"
      ],
      "doesNotOwn": [
        "canonical component behavior",
        "Custom Element implementation",
        "shared design tokens or themes",
        "application state",
        "backend workflows"
      ],
      "cssImport": "not-applicable",
      "apiDoc": "packages/ui-angular/README.md",
      "dependsOn": ["@vyrnforge/ui-elements"],
      "mustNotDependOn": [
        "@vyrnforge/ui-components",
        "@vyrnforge/ui-vue",
        "@vyrnforge/ui-data-grid",
        "React",
        "React DOM",
        "Vue",
        "Redux",
        "TanStack",
        "MUI",
        "Radix",
        "Tailwind"
      ],
      "status": "current",
      "releaseTrack": "non-grid-beta",
      "publicEntryPoints": ["@vyrnforge/ui-angular", "@vyrnforge/ui-angular/forms"],
      "notes": "First-class Angular facade over ui-elements; Angular framework dependencies remain peer dependencies."
    },
    {
      "name": "@vyrnforge/ui-vue",
      "purpose": "First-class Vue facade over the canonical VyrnForge Custom Element implementation and shared contracts.",
      "owns": [
        "Vue component facades",
        "Vue-native props and typed emits",
        "v-model translations",
        "Vue slot projection",
        "typed component refs",
        "Vue setup and plugin helpers"
      ],
      "doesNotOwn": [
        "canonical Custom Element rendering",
        "framework-neutral behavior controllers",
        "design tokens",
        "application state",
        "backend workflows",
        "data grid rendering"
      ],
      "cssImport": "not-applicable",
      "apiDoc": "docs/packages/ui-vue.md",
      "dependsOn": ["@vyrnforge/ui-elements"],
      "mustNotDependOn": [
        "@vyrnforge/ui-core",
        "@vyrnforge/ui-behaviors",
        "@vyrnforge/ui-components",
        "@vyrnforge/ui-angular",
        "@vyrnforge/ui-data-grid",
        "React",
        "React DOM",
        "Angular",
        "Redux",
        "TanStack",
        "MUI",
        "Radix",
        "Tailwind"
      ],
      "status": "current",
      "publicEntryPoints": ["@vyrnforge/ui-vue"],
      "notes": "First-class Vue facade over @vyrnforge/ui-elements. Vue remains a peer dependency, canonical rendering and behavior stay shared, and the package participates in the synchronized non-grid beta release line.",
      "releaseTrack": "non-grid-beta"
    },
    {
      "name": "@vyrnforge/ui-data-grid",
      "purpose": "Specialized enterprise data-management grid and grid contracts.",
      "owns": [
        "UniversalDataGrid",
        "grid-specific udg-* styles",
        "grid state contracts",
        "grid core helpers",
        "persistence/server/export adapters"
      ],
      "doesNotOwn": [
        "API calls",
        "export file generation by default",
        "report engine",
        "global store",
        "backend business workflows"
      ],
      "cssImport": "@vyrnforge/ui-data-grid/styles/index.css",
      "apiDoc": "docs/api/ui-data-grid-api.md",
      "dependsOn": ["@vyrnforge/ui-core", "@vyrnforge/ui-components"],
      "mustNotDependOn": ["Redux", "TanStack", "MUI", "Radix", "Tailwind"],
      "status": "react-alpha-deferred",
      "publicEntryPoints": [
        "@vyrnforge/ui-data-grid",
        "@vyrnforge/ui-data-grid/styles/index.css",
        "@vyrnforge/ui-data-grid/style.css",
        "@vyrnforge/ui-data-grid/index.css"
      ],
      "notes": "Apps own rows, fetching, permissions, business actions, and file generation. Grid decomposition, scale work, and multi-framework rendering are deferred until after the non-grid beta.",
      "releaseTrack": "independent-alpha"
    }
  ],
  "dependencyRules": [
    "ui-core depends on no VyrnForge package",
    "ui-behaviors may depend on ui-core only",
    "ui-elements may depend on ui-core and ui-behaviors only",
    "ui-components may depend on ui-core, ui-behaviors, and ui-elements only",
    "ui-angular may depend on ui-elements and Angular peer dependencies only",
    "ui-vue may depend on ui-elements and Vue peer dependencies only",
    "ui-data-grid may depend on ui-core and ui-components",
    "ui-core and ui-behaviors must not depend on React, Vue, Angular, or a DOM renderer",
    "framework facades must not depend on one another or ui-data-grid",
    "ui-data-grid remains outside the non-grid beta release group"
  ],
  "releaseGroups": {
    "nonGridBeta": [
      "@vyrnforge/ui-core",
      "@vyrnforge/ui-behaviors",
      "@vyrnforge/ui-components",
      "@vyrnforge/ui-elements",
      "@vyrnforge/ui-angular",
      "@vyrnforge/ui-vue"
    ],
    "dataGridAlpha": ["@vyrnforge/ui-data-grid"]
  }
}
