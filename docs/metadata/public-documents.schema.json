{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public-documents.schema.json",
  "title": "VyrnForge public documentation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "sourceOfTruth",
    "purpose",
    "categories",
    "documents"
  ],
  "properties": {
    "$schema": {
      "const": "./public-documents.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceOfTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "scope",
        "documentation"
      ],
      "properties": {
        "canonical": {
          "const": true
        },
        "scope": {
          "const": "public-document-presentation"
        },
        "documentation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "order"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "title",
          "type",
          "domain",
          "category",
          "order",
          "description",
          "sourcePath",
          "renderer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "guide",
              "component",
              "foundation",
              "pattern",
              "advanced-module",
              "package",
              "migration",
              "example"
            ]
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "renderer": {
            "enum": [
              "overview",
              "markdown",
              "component-reference",
              "token-reference",
              "pattern-reference",
              "package-reference",
              "example",
              "executable-examples"
            ]
          },
          "exampleId": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
