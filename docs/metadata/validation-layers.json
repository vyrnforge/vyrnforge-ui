{
  "schemaVersion": 2,
  "guidingRule": "Every validation concern has one owner and one normal path.",
  "layers": {
    "pull-request": {
      "purpose": "Run only the affected checks required to merge safely.",
      "entrypoint": "node scripts/run-scoped-quality.mjs"
    },
    "main": {
      "purpose": "Validate delivery-sensitive work on protected main through the canonical CI workflow.",
      "entrypoint": ".github/workflows/ci.yml"
    },
    "nightly": {
      "purpose": "Run full quality, integration, compatibility, dependency, security, and size assurance.",
      "entrypoint": ".github/workflows/assurance.yml"
    },
    "release": {
      "purpose": "Run release-specific checks against a successful current-main candidate.",
      "entrypoint": ".github/workflows/release.yml"
    }
  },
  "publicCommands": ["check", "test", "build", "ci"],
  "internalCommandGroups": {
    "activeContractTests": "npm run test:contracts",
    "activeMetadata": "npm run verify:metadata"
  },
  "checks": [
    {
      "id": "repository-formatting",
      "owner": "pull-request",
      "command": "npm run format:check",
      "reusedBy": ["main", "nightly"],
      "reuseReason": "The same repository formatting contract is reused at stronger trust boundaries."
    },
    {
      "id": "repository-lint",
      "owner": "pull-request",
      "command": "npm run lint",
      "reusedBy": ["main", "nightly"],
      "reuseReason": "The same lint contract is reused at stronger trust boundaries."
    },
    {
      "id": "repository-css-lint",
      "owner": "pull-request",
      "command": "npm run lint:css",
      "reusedBy": ["main", "nightly"],
      "reuseReason": "The same CSS lint contract is reused at stronger trust boundaries."
    },
    {
      "id": "documentation-current",
      "owner": "pull-request",
      "command": "npm run verify:documentation-current",
      "reusedBy": ["main", "nightly"],
      "reuseReason": "Reader-facing documentation remains part of repository quality at every trust boundary."
    },
    {
      "id": "affected-code-validation",
      "owner": "pull-request",
      "command": "node scripts/run-scoped-quality.mjs"
    },
    {
      "id": "affected-browser-contracts",
      "owner": "pull-request",
      "command": "npm run test:browser"
    },
    {
      "id": "scoped-security",
      "owner": "pull-request",
      "command": ".github/workflows/ci.yml#security-checks"
    },
    {
      "id": "complete-repository-validation",
      "owner": "main",
      "command": "npm run ci"
    },
    {
      "id": "packed-consumer-verification",
      "owner": "main",
      "command": "npm run verify:consumer"
    },
    {
      "id": "complete-compatibility-matrix",
      "owner": "nightly",
      "command": ".github/workflows/assurance.yml#compatibility"
    },
    {
      "id": "dependency-audit-and-codeql",
      "owner": "nightly",
      "command": ".github/workflows/assurance.yml#security-drift"
    },
    {
      "id": "release-candidate-inputs",
      "owner": "release",
      "command": "node scripts/verify-release-candidate.mjs"
    },
    {
      "id": "release-package-budgets",
      "owner": "release",
      "command": "npm run verify:release-size-budgets"
    },
    {
      "id": "release-publication-dry-run",
      "owner": "release",
      "command": "npm run verify:trusted-publishing-dry-run"
    },
    {
      "id": "release-registry-and-provenance",
      "owner": "release",
      "command": "npm run verify:registry-release"
    }
  ]
}
