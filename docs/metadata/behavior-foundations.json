{
  "schemaVersion": 2,
  "package": "@vyrnforge/ui-behaviors",
  "status": "current",
  "scope": "framework-neutral reusable behavior contracts and React adapter adoption",
  "contracts": {
    "controllableState": {
      "factory": "createControllableState",
      "controlledDetection": "property-presence",
      "committedSnapshotMethods": ["getSnapshot", "subscribe", "syncValue"],
      "changeRequestMethods": ["setValue", "reset"],
      "event": "value-change"
    },
    "collection": {
      "factory": "createCollectionController",
      "keyTypes": ["string", "number"],
      "navigation": ["first", "last", "next", "previous"],
      "rules": [
        "deterministic-order",
        "disabled-items-skipped",
        "loop-or-clamp",
        "active-item-reconciled-after-mutation"
      ],
      "events": ["collection-change", "active-change"]
    },
    "selection": {
      "factory": "createSelectionController",
      "modes": ["single", "multiple"],
      "operations": ["select", "deselect", "toggle", "range", "replace", "clear"],
      "rules": [
        "unique-keys",
        "disabled-keys-rejected",
        "ordered-range-source",
        "controlled-proposals-require-sync"
      ],
      "event": "selection-change"
    },
    "events": {
      "factory": "createBehaviorEvent",
      "channelFactory": "createBehaviorEventChannel",
      "snapshotChannelFactory": "createBehaviorSnapshotChannel",
      "reasons": [
        "user",
        "programmatic",
        "keyboard",
        "pointer",
        "selection",
        "collection-change",
        "clear",
        "reset",
        "restore"
      ],
      "rules": [
        "immutable-event-record",
        "stable-listener-snapshot",
        "idempotent-unsubscribe"
      ]
    },
    "actionToggle": {
      "factories": ["resolveActionState", "createToggleController", "createToggleGroupController"],
      "reactAdapters": ["Button", "IconButton", "ToggleButton", "ToggleButtonGroup", "SegmentedControl"],
      "rules": [
        "loading-disables-action",
        "controlled-toggle-proposals",
        "single-and-multiple-toggle-groups"
      ]
    },
    "choice": {
      "factory": "createChoiceController",
      "reactAdapters": ["SegmentedControl", "RadioGroup"],
      "rules": [
        "disabled-choice-rejected",
        "deterministic-order",
        "active-navigation-skips-disabled"
      ]
    },
    "numeric": {
      "factory": "createNumericValueController",
      "normalizer": "normalizeNumericValue",
      "reactAdapters": ["Slider", "Rating"],
      "rules": [
        "clamp-range",
        "finite-values",
        "optional-step-alignment",
        "controlled-proposals-require-sync"
      ]
    },
    "tabs": {
      "factory": "createTabsController",
      "reactAdapter": "Tabs",
      "rules": [
        "disabled-tabs-skipped",
        "home-end-navigation",
        "automatic-activation",
        "dom-focus-owned-by-renderer"
      ]
    },
    "nativeToggleInputs": {
      "resolver": "resolveToggleInputState",
      "reactAdapters": ["Checkbox", "Switch"],
      "rules": [
        "native-input-state-preserved",
        "form-reset-remains-native",
        "disabled-and-readonly-interactivity"
      ]
    },
    "autocomplete": {
      "factory": "createAutocompleteController",
      "reactAdapter": "Autocomplete",
      "rules": [
        "controlled-value-input-and-open-proposals",
        "filter-and-keyword-matching",
        "disabled-options-skipped",
        "selection-restores-label",
        "dom-focus-owned-by-renderer"
      ]
    },
    "multiSelect": {
      "factory": "createMultiSelectController",
      "reactAdapter": "MultiSelect",
      "rules": [
        "controlled-selection-proposals",
        "query-filtering",
        "disabled-options-rejected",
        "looping-active-navigation",
        "dom-focus-owned-by-renderer"
      ]
    },
    "transferList": {
      "factory": "createTransferListController",
      "reactAdapter": "TransferList",
      "rules": [
        "ordered-source-target-partition",
        "visible-selection",
        "disabled-items-not-moved",
        "controlled-target-proposals",
        "independent-panel-filtering"
      ]
    },
    "navigation": {
      "factory": "createNavigationController",
      "reactAdapters": ["Menu", "SideNav"],
      "rules": [
        "roving-active-item",
        "home-end-navigation",
        "disabled-items-skipped",
        "selection-reasons",
        "dismissal-reasons"
      ]
    },
    "overlay": {
      "lifecycleFactory": "createOverlayLifecycleController",
      "layerRegistryFactory": "createOverlayLayerRegistry",
      "positionResolver": "resolveOverlayPosition",
      "reactAdapters": ["Popover", "Dialog", "Drawer"],
      "adapterContracts": ["OverlayFocusAdapter", "OverlayLayerRegistry", "OverlayPositionAdapter"],
      "rules": [
        "controlled-open-proposals",
        "explicit-dismissal-reasons",
        "renderer-owned-focus",
        "renderer-owned-dom-measurement",
        "framework-neutral-layer-order"
      ]
    },
    "overlayComponents": {
      "factories": [
        "createDialogController",
        "createDrawerController",
        "createPopoverController",
        "createTooltipController"
      ],
      "reactAdapters": ["Dialog", "Drawer", "Popover", "Tooltip"],
      "rules": [
        "component-kind-contract",
        "controlled-open-proposals",
        "trigger-content-relationship",
        "disabled-tooltip-rejected",
        "renderer-owned-timers-and-dom"
      ]
    },
    "toast": {
      "factory": "createToastController",
      "reactAdapter": "ToastProvider",
      "rules": [
        "deterministic-queue",
        "visible-window",
        "explicit-duration",
        "pause-resume-state",
        "action-and-dismissal-events"
      ]
    },
    "confirmDialog": {
      "factory": "createConfirmDialogController",
      "reactAdapter": "ConfirmDialog",
      "rules": [
        "controlled-open-proposals",
        "loading-blocks-user-dismissal",
        "disabled-actions-rejected",
        "explicit-cancel-and-confirm-events"
      ]
    }
  },
  "boundaries": {
    "allowedPackageDependencies": ["@vyrnforge/ui-core"],
    "forbiddenRuntimes": ["react", "react-dom", "vue", "@angular/*"],
    "forbiddenDomIdentifiers": [
      "HTMLElement",
      "ElementInternals",
      "CustomEvent",
      "document",
      "window",
      "customElements"
    ],
    "ownsCss": false
  },
  "evidence": {
    "reactAdoption": "docs/metadata/react-behavior-adoption.json",
    "behaviorContracts": "docs/testing/behavior-foundation-contracts.md",
    "reactParity": "docs/testing/behavior-react-parity.md",
    "reactAdoptionAudit": "docs/testing/react-behavior-adoption-audit.md"
  },
  "requiredCommands": [
    "npm run test:behavior-foundations",
    "npm run verify:behavior-foundations",
    "npm run test:coverage --workspace @vyrnforge/ui-behaviors",
    "npm run verify:package-boundaries",
    "npm run test:coverage --workspace @vyrnforge/ui-components",
    "npm run typecheck --workspace @vyrnforge/ui-components",
    "npm run test:react-behavior-adoption",
    "npm run verify:react-behavior-adoption",
    "npm run check",
    "npm run ci"
  ]
}
