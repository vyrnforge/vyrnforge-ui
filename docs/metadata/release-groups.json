{
  "$schema": "./release-groups.schema.json",
  "schemaVersion": 2,
  "sourceOfTruth": {
    "canonical": true,
    "scope": "release-groups",
    "documentation": "docs/release/versioning-policy.md"
  },
  "releaseLines": {
    "non-grid-beta": {
      "intent": "synchronized non-grid foundation and renderer prerelease",
      "channel": "beta",
      "version": "0.2.0-beta.2",
      "distTag": "beta",
      "versioning": {
        "mode": "synchronized"
      },
      "publication": {
        "publishable": true,
        "publishTogether": true
      },
      "tagIdentity": {
        "scope": "release-line",
        "legacyPolicy": "preserve-only"
      },
      "validation": {
        "artifacts": true,
        "provenance": true,
        "registry": true,
        "consumer": true
      },
      "releaseDependencies": [],
      "packages": [
        {
          "name": "@vyrnforge/ui-core",
          "directory": "packages/ui-core",
          "role": "framework-neutral-foundation",
          "dependencies": {},
          "policies": {
            "hasCss": true,
            "versionExport": {
              "path": "packages/ui-core/src/index.ts",
              "symbol": "vyrnForgeUiCoreVersion"
            }
          }
        },
        {
          "name": "@vyrnforge/ui-behaviors",
          "directory": "packages/ui-behaviors",
          "role": "framework-neutral-behavior",
          "dependencies": {
            "@vyrnforge/ui-core": "0.2.0-beta.2"
          },
          "policies": {
            "hasCss": false,
            "versionExport": {
              "path": "packages/ui-behaviors/src/index.ts",
              "symbol": "vyrnForgeUiBehaviorsVersion"
            }
          }
        },
        {
          "name": "@vyrnforge/ui-components",
          "directory": "packages/ui-components",
          "role": "react-renderer",
          "dependencies": {
            "@vyrnforge/ui-core": "0.2.0-beta.2",
            "@vyrnforge/ui-behaviors": "0.2.0-beta.2"
          },
          "policies": {
            "hasCss": true,
            "versionExport": {
              "path": "packages/ui-components/src/index.ts",
              "symbol": "vyrnForgeUiComponentsVersion"
            }
          }
        },
        {
          "name": "@vyrnforge/ui-elements",
          "directory": "packages/ui-elements",
          "role": "native-html-renderer",
          "dependencies": {
            "@vyrnforge/ui-core": "0.2.0-beta.2",
            "@vyrnforge/ui-behaviors": "0.2.0-beta.2"
          },
          "policies": {
            "hasCss": true,
            "versionExport": {
              "path": "packages/ui-elements/src/index.ts",
              "symbol": "vyrnForgeUiElementsVersion"
            }
          }
        }
      ]
    },
    "data-grid-alpha": {
      "intent": "independently versioned specialized data-grid prerelease",
      "channel": "alpha",
      "version": "0.1.0-alpha.2",
      "distTag": "alpha",
      "versioning": {
        "mode": "independent"
      },
      "publication": {
        "publishable": true,
        "publishTogether": false
      },
      "tagIdentity": {
        "scope": "release-line",
        "legacyPolicy": "preserve-only"
      },
      "validation": {
        "artifacts": true,
        "provenance": true,
        "registry": true,
        "consumer": true
      },
      "releaseDependencies": [
        {
          "releaseLine": "non-grid-beta",
          "policy": "exact"
        }
      ],
      "packages": [
        {
          "name": "@vyrnforge/ui-data-grid",
          "directory": "packages/ui-data-grid",
          "role": "react-data-grid",
          "dependencies": {
            "@vyrnforge/ui-core": "0.2.0-beta.2",
            "@vyrnforge/ui-components": "0.2.0-beta.2"
          },
          "policies": {
            "hasCss": true,
            "versionExport": null
          }
        }
      ]
    }
  }
}
