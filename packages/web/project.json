{
  "name": "@vyrnforge/web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/web/src",
  "projectType": "library",
  "tags": [
    "scope:public",
    "platform:web"
  ],
  "namedInputs": {
    "default": [
      "productGraphInputs",
      "{workspaceRoot}/product/components/**/web/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "node tooling/product/build-projected-package.mjs web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec eslint packages/web/src packages/web/test --max-warnings=0",
          "pnpm exec stylelint \"packages/web/src/**/*.css\" \"product/components/**/web/**/*.css\""
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "node tooling/product/typecheck-projected-package.mjs web && pnpm exec tsc -p packages/web/tsconfig.test.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "pnpm exec vitest run --project web --passWithNoTests"
      }
    }
  }
}
