    "./styles/radio.css": "./dist/components/radio/radio.css",
    "./styles/slider.css": "./dist/components/slider/slider.css",
    "./styles/switch.css": "./dist/components/switch/switch.css",
    "./styles/temporal-input.css": "./dist/components/temporal-input/temporal-input.css",
    "./styles/textarea.css": "./dist/components/textarea/textarea.css",
