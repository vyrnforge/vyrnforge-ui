{
  "name": "@vyrnforge/web",
  "version": "0.0.0-rebuild",
  "private": true,
  "type": "module",
  "description": "Browser-facing VyrnForge foundations, canonical CSS, and DOM helpers.",
  "sideEffects": ["./dist/**/*.css"],
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icon": {
      "types": "./dist/components/icon/index.d.ts",
      "import": "./dist/components/icon/index.js",
      "default": "./dist/components/icon/index.js"
    },
    "./layout": {
      "types": "./dist/components/layout/index.d.ts",
      "import": "./dist/components/layout/index.js",
      "default": "./dist/components/layout/index.js"
    },
    "./text": {
      "types": "./dist/components/text/index.d.ts",
      "import": "./dist/components/text/index.js",
      "default": "./dist/components/text/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/button.css": "./dist/components/button/button.css",
    "./styles/dialog.css": "./dist/components/dialog/dialog.css",
    "./styles/icon.css": "./dist/components/icon/icon.css",
    "./styles/layout.css": "./dist/components/layout/layout.css",
    "./styles/surface.css": "./dist/components/surface/surface.css",
    "./styles/tabs.css": "./dist/components/tabs/tabs.css",
    "./styles/text.css": "./dist/components/text/text.css"
  },
  "dependencies": {
    "@vyrnforge/core": "0.0.0-rebuild"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../tooling/build/copy-web-assets.mjs"
  }
}
