{
  "schemaVersion": 1,
  "id": "button",
  "name": "Button",
  "package": "@vyrnforge/ui-components",
  "category": "primitive",
  "maturity": "experimental",
  "availability": "available",
  "purpose": "Text action control for primary, secondary, subtle, danger, and ghost actions.",
  "guidance": {
    "useWhen": "Use for primary business actions such as Save, Submit, Create, or Cancel.",
    "avoidWhen": "Avoid for repeated icon-only utilities; use IconButton or ToolbarButton instead.",
    "aiUsageNotes": "Use visible text for important actions.",
    "relatedComponents": [
      "IconButton",
      "ToolbarButton",
      "ButtonGroup"
    ]
  },
  "accessibility": [
    "Button renders a native button and supports disabled/loading states.",
    "native button semantics",
    "disabled/loading state",
    "accessible name"
  ],
  "knownLimitations": [
    "Avoid for repeated icon-only utilities; use IconButton or ToolbarButton instead."
  ],
  "examples": [
    {
      "id": "variants",
      "title": "Variants",
      "intent": "Compare the supported visual intents before choosing emphasis for an action.",
      "frameworks": [
        "native-html",
        "react",
        "angular",
        "vue"
      ]
    },
    {
      "id": "sizes",
      "title": "Sizes",
      "intent": "Compare the supported size scale against the surrounding control density.",
      "frameworks": [
        "native-html",
        "react",
        "angular",
        "vue"
      ]
    },
    {
      "id": "states",
      "title": "Disabled and loading",
      "intent": "Show unavailable and in-progress actions using the shared disabled and loading behavior contract.",
      "frameworks": [
        "native-html",
        "react",
        "angular",
        "vue"
      ]
    },
    {
      "id": "width",
      "title": "Full width",
      "intent": "Show a prominent action expanding to the available inline space.",
      "frameworks": [
        "native-html",
        "react",
        "angular",
        "vue"
      ]
    },
    {
      "id": "content",
      "title": "Icons and labels",
      "intent": "Compose visible labels with leading or trailing icon content without replacing important text.",
      "frameworks": [
        "native-html",
        "react",
        "angular",
        "vue"
      ]
    },
    {
      "id": "form-actions",
      "title": "Form actions",
      "intent": "Use explicit submit and reset button types when Button participates in a form workflow.",
      "frameworks": [
        "native-html",
        "react",
        "angular",
        "vue"
      ]
    }
  ],
  "releaseNotes": [],
  "styling": {
    "classes": [
      "vf-button"
    ],
    "variables": []
  },
  "frameworks": {
    "react": {
      "status": "current",
      "package": "@vyrnforge/ui-components",
      "setup": "import { Button } from '@vyrnforge/ui-components';",
      "example": "<Button variant='primary'>Save</Button>"
    },
    "native-html": {
      "status": "current",
      "package": "@vyrnforge/ui-elements",
      "setup": "import \"@vyrnforge/ui-elements/register\";",
      "example": "<vf-button></vf-button>"
    },
    "angular": {
      "status": "verified-consumer",
      "package": "@vyrnforge/ui-angular",
      "setup": "import { provideVyrnForge } from \"@vyrnforge/ui-angular\";\n// add provideVyrnForge() to bootstrapApplication providers",
      "example": "<vf-button></vf-button>"
    },
    "vue": {
      "status": "verified-consumer",
      "package": "@vyrnforge/ui-vue",
      "setup": "import { VyrnForgeVue } from \"@vyrnforge/ui-vue\";\napp.use(VyrnForgeVue);",
      "example": "<VfButton></VfButton>"
    }
  },
  "contract": {
    "properties": [
      {
        "name": "variant",
        "type": "ButtonVariant",
        "required": false,
        "default": "primary"
      },
      {
        "name": "disabled",
        "type": "boolean",
        "required": false,
        "default": false
      },
      {
        "name": "loading",
        "type": "boolean",
        "required": false,
        "default": false
      },
      {
        "name": "size",
        "type": "ButtonSize",
        "required": false,
        "default": "md"
      },
      {
        "name": "fullWidth",
        "type": "boolean",
        "required": false,
        "default": false
      },
      {
        "name": "type",
        "type": "ButtonType",
        "required": false,
        "default": "button"
      },
      {
        "name": "name",
        "type": "string",
        "required": false,
        "default": null
      },
      {
        "name": "value",
        "type": "string",
        "required": false,
        "default": ""
      },
      {
        "name": "action",
        "type": "string",
        "required": false,
        "default": ""
      }
    ],
    "events": [
      {
        "name": "vf-action"
      }
    ],
    "slots": [
      "default",
      "prefix",
      "suffix"
    ],
    "methods": [
      "focus",
      "click"
    ],
    "accessibility": [
      "native button semantics",
      "disabled/loading state",
      "accessible name"
    ],
    "formAssociation": "none"
  },
  "source": {
    "componentMetadata": "docs/metadata/components.json",
    "contractMetadata": "docs/metadata/component-contracts.json",
    "componentDocumentation": "packages/ui-elements/src/components/button.docs.json",
    "customElementsManifest": "packages/ui-elements/custom-elements.json"
  }
}
