{
  "name": "@vyrnforge/angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular",
  "projectType": "library",
  "tags": [
    "scope:public",
    "platform:angular"
  ],
  "namedInputs": {
    "default": [
      "productGraphInputs",
      "{workspaceRoot}/product/components/**/angular/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "node tooling/product/build-projected-package.mjs angular"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint packages/angular --max-warnings=0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        {
          "projects": ["@vyrnforge/icons"],
          "target": "build"
        }
      ],
      "options": {
        "command": "node tooling/product/typecheck-projected-package.mjs angular && pnpm exec tsc -p packages/angular/tsconfig.test.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        {
          "projects": ["@vyrnforge/icons"],
          "target": "build"
        }
      ],
      "options": {
        "command": "pnpm exec vitest run --project angular --passWithNoTests"
      }
    }
  }
}
