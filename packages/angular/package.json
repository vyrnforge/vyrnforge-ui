{
  "name": "@vyrnforge/angular",
  "version": "0.0.0-rebuild",
  "private": true,
  "type": "module",
  "description": "Angular integration for VyrnForge shared component contracts.",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js",
      "default": "./dist/button.js"
    }
  },
  "dependencies": {
    "@vyrnforge/core": "0.0.0-rebuild",
    "@vyrnforge/web": "0.0.0-rebuild"
  },
  "peerDependencies": {
    "@angular/core": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "ngc -p tsconfig.json"
  }
}
