{
  "name": "@vyrnforge/vue",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/vue/src",
  "projectType": "library",
  "tags": [
    "scope:public",
    "platform:vue"
  ],
  "namedInputs": {
    "default": [
      "productGraphInputs",
      "{workspaceRoot}/product/components/**/vue/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "node tooling/product/build-projected-package.mjs vue"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint packages/vue/src packages/vue/test --max-warnings=0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node tooling/product/typecheck-projected-package.mjs vue && pnpm exec tsc -p packages/vue/tsconfig.test.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "pnpm exec vitest run --project vue --passWithNoTests"
      }
    }
  }
}
