{
  "name": "@vyrnforge/vue",
  "version": "0.0.0-rebuild",
  "private": true,
  "type": "module",
  "description": "Vue integration for VyrnForge shared component contracts.",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./button": { "types": "./dist/components/button/index.d.ts", "import": "./dist/components/button/index.js", "default": "./dist/components/button/index.js" },
    "./dialog": { "types": "./dist/components/dialog/index.d.ts", "import": "./dist/components/dialog/index.js", "default": "./dist/components/dialog/index.js" },
    "./icon": { "types": "./dist/components/icon/index.d.ts", "import": "./dist/components/icon/index.js", "default": "./dist/components/icon/index.js" },
    "./layout": { "types": "./dist/components/layout/index.d.ts", "import": "./dist/components/layout/index.js", "default": "./dist/components/layout/index.js" },
    "./surface": { "types": "./dist/components/surface/index.d.ts", "import": "./dist/components/surface/index.js", "default": "./dist/components/surface/index.js" },
    "./tabs": { "types": "./dist/components/tabs/index.d.ts", "import": "./dist/components/tabs/index.js", "default": "./dist/components/tabs/index.js" },
    "./text": { "types": "./dist/components/text/index.d.ts", "import": "./dist/components/text/index.js", "default": "./dist/components/text/index.js" }
  },
  "dependencies": { "@vyrnforge/core": "0.0.0-rebuild", "@vyrnforge/web": "0.0.0-rebuild" },
  "peerDependencies": { "vue": ">=3.5.0 <3.6.0" },
  "scripts": { "build": "tsc -p tsconfig.json" }
}
