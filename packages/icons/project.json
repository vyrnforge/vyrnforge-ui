{
  "name": "@vyrnforge/icons",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/icons/src",
  "projectType": "library",
  "tags": [
    "scope:public",
    "platform:icons"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "pnpm --filter @vyrnforge/icons run build"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint packages/icons/src packages/icons/test --max-warnings=0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "pnpm exec tsc -p packages/icons/tsconfig.json --noEmit && pnpm exec tsc -p packages/icons/tsconfig.test.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "pnpm exec vitest run --project icons --passWithNoTests"
      }
    }
  }
}
