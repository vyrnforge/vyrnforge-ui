{
  "name": "@vyrnforge/icons",
  "version": "0.0.0-rebuild",
  "private": true,
  "type": "module",
  "description": "Official VyrnForge SVG icon catalog for the shared Icon contract.",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bookmark": {
      "types": "./dist/bookmark/index.d.ts",
      "import": "./dist/bookmark/index.js",
      "default": "./dist/bookmark/index.js"
    }
  },
  "dependencies": {
    "@vyrnforge/web": "0.0.0-rebuild"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
