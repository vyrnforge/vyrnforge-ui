{
  "name": "@vyrnforge/elements",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/elements/src",
  "projectType": "library",
  "tags": ["scope:public", "platform:elements"],
  "targets": {
    "build": {"executor":"nx:run-commands","outputs":["{projectRoot}/dist"],"options":{"command":"pnpm --filter @vyrnforge/elements run build"}},
    "lint": {"executor":"nx:run-commands","options":{"command":"pnpm exec eslint packages/elements/src --max-warnings=0"}},
    "typecheck": {"executor":"nx:run-commands","dependsOn":["^build"],"options":{"command":"pnpm exec tsc -p packages/elements/tsconfig.json --noEmit && pnpm exec tsc -p packages/elements/tsconfig.test.json"}},
    "test": {"executor":"nx:run-commands","dependsOn":["build"],"options":{"command":"pnpm exec vitest run --project elements --passWithNoTests"}}
  }
}
