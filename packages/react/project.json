{
  "name": "@vyrnforge/react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react/src",
  "projectType": "library",
  "tags": [
    "scope:public",
    "platform:react"
  ],
  "namedInputs": {
    "default": [
      "productGraphInputs",
      "{workspaceRoot}/product/components/**/react/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "node tooling/product/build-projected-package.mjs react"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint packages/react/src packages/react/test --max-warnings=0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        {
          "projects": [
            "@vyrnforge/icons"
          ],
          "target": "build"
        }
      ],
      "options": {
        "command": "node tooling/product/typecheck-projected-package.mjs react && pnpm exec tsc -p packages/react/tsconfig.test.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        {
          "projects": [
            "@vyrnforge/icons"
          ],
          "target": "build"
        }
      ],
      "options": {
        "command": "pnpm exec vitest run --project react --passWithNoTests"
      }
    }
  }
}
