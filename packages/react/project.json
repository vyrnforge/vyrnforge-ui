{
  "name": "@vyrnforge/react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react/src",
  "projectType": "library",
  "tags": [
    "scope:public",
    "platform:react"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "pnpm --filter @vyrnforge/react run build"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint packages/react/src packages/react/test --max-warnings=0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "pnpm exec tsc -p packages/react/tsconfig.json --noEmit && pnpm exec tsc -p packages/react/tsconfig.test.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "pnpm exec vitest run --project react --passWithNoTests"
      }
    }
  }
}
