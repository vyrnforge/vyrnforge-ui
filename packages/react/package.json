{
  "name": "@vyrnforge/react",
  "version": "0.0.0-rebuild",
  "private": true,
  "type": "module",
  "description": "React integration for VyrnForge shared component contracts.",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js",
      "default": "./dist/components/button/index.js"
    },
    "./tabs": {
      "types": "./dist/components/tabs/index.d.ts",
      "import": "./dist/components/tabs/index.js",
      "default": "./dist/components/tabs/index.js"
    }
  },
  "dependencies": {
    "@vyrnforge/core": "0.0.0-rebuild",
    "@vyrnforge/web": "0.0.0-rebuild"
  },
  "peerDependencies": {
    "react": ">=19.3.0 <20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
