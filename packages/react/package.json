    "./text": { "types": "./dist/components/text/index.d.ts", "import": "./dist/components/text/index.js", "default": "./dist/components/text/index.js" },
    "./visually-hidden": { "types": "./dist/components/visually-hidden/index.d.ts", "import": "./dist/components/visually-hidden/index.js", "default": "./dist/components/visually-hidden/index.js" }
