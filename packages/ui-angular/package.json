{
  "name": "@vyrnforge/ui-angular",
  "version": "0.2.0-beta.2",
  "description": "Angular facade for VyrnForge canonical UI elements",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "lint": "eslint src --config ../../eslint.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "pretypecheck": "npm run build --workspace @vyrnforge/ui-core && npm run build --workspace @vyrnforge/ui-behaviors && npm run build --workspace @vyrnforge/ui-elements",
    "typecheck": "ngc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vyrnforge/ui-elements": "0.2.0-beta.2"
  },
  "devDependencies": {
    "@angular/compiler-cli": "22.0.8",
    "@angular/core": "22.0.8",
    "typescript": "6.0.2",
    "vitest": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vyrnforge/vyrnforge-ui.git",
    "directory": "packages/ui-angular"
  },
  "homepage": "https://github.com/vyrnforge/vyrnforge-ui#readme",
  "bugs": {
    "url": "https://github.com/vyrnforge/vyrnforge-ui/issues"
  },
  "engines": {
    "node": ">=24.18 <25",
    "npm": ">=11.16 <12"
  }
}
