{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs",
  "projectType": "application",
  "tags": [
    "scope:docs"
  ],
  "namedInputs": {
    "default": [
      "productGraphInputs",
      "{workspaceRoot}/documentation/**/*",
      "{workspaceRoot}/tooling/docs/**/*.mjs",
      "{workspaceRoot}/product/components/**/docs/**/*",
      "{workspaceRoot}/product/components/**/examples/**/*",
      "{workspaceRoot}/product/components/**/accessibility.json"
    ]
  },
  "implicitDependencies": [
    "@vyrnforge/web"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{workspaceRoot}/dist/docs"
      ],
      "options": {
        "command": "node apps/docs/build.mjs"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint apps/docs tooling/docs --max-warnings=0"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --project docs --passWithNoTests"
      }
    }
  }
}
