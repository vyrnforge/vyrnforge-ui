{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs",
  "projectType": "application",
  "tags": ["scope:docs"],
  "implicitDependencies": [
    "@vyrnforge/core",
    "@vyrnforge/web",
    "@vyrnforge/icons",
    "@vyrnforge/react",
    "@vyrnforge/angular",
    "@vyrnforge/vue",
    "@vyrnforge/elements"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/docs"],
      "options": {"command":"node apps/docs/build.mjs"}
    },
    "lint": {"executor":"nx:run-commands","options":{"command":"pnpm exec eslint apps/docs --max-warnings=0"}},
    "test": {"executor":"nx:run-commands","options":{"command":"pnpm exec vitest run --project docs --passWithNoTests"}}
  }
}
